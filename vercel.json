{
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "app.py",
      "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':!reports/'"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
