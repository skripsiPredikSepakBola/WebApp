{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':!models/team_state.json' ':!models/league_state.json' ':!reports/'",
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "app.py"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
